{
  "name": "downloadany",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:preview": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.160.0"
  }
}
