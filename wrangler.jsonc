{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "downloadany",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "ALLOWED_HOSTS": "" },
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "INSPECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
